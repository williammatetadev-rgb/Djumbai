# Djumbai — Exemplo de Configuração de Ambiente para Produção / Staging
# Copie este ficheiro para .env e preencha as variáveis correspondentes.
# NUNCA comite o ficheiro .env com dados reais em repositórios públicos.

# Ambiente da Aplicação
# Em produção: defina APP_ENV=production e APP_DEBUG=false para não expor stack traces ou dados sensíveis.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://djumbai.ao
APP_URL_PATH=/

# Base de Dados (MySQL / MariaDB)
# Em produção: configure uma senha forte e utilize um utilizador dedicado sem privilégios de administração global (GRANT).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=djumbai
DB_USER=djumbai_app
DB_PASS=SuaSenhaForteAqui123!@#
DB_CHARSET=utf8mb4

# Segurança & Sessões
SESSION_LIFETIME=7200
CSRF_LIFETIME=3600
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# Restrição Territorial de Lançamento (0 = Todos os municípios liberados, 3 = Restrito a Cacuaco)
MUNICIPIO_ATIVO_ID=0

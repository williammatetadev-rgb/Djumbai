# Djumbai — Configuração de Ambiente
# Copie este arquivo para .env e ajuste com as credenciais do seu servidor

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/djumbai/public

# Base de Dados MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=djumbai
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Segurança & Sessões
SESSION_LIFETIME=7200
CSRF_LIFETIME=3600
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900
